{
	"extends": "@isentinel/tsconfig/typescript",
	"compilerOptions": {
		"allowJs": true,
		"exactOptionalPropertyTypes": false,
		"isolatedDeclarations": false
	},
	"exclude": [
		"**/node_modules",
		"./**/.*/",
		"./dist",
		"./_fixtures/**/*.*",
		"./fixtures/**/*.*",
		"./references/**/*.*",
		"./eslint-inspector.config.ts"
	]
}
